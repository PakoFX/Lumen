<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja inferior de detalle (Exámenes / Foros). La llena ui/common/DetalleSheet.kt -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Agarradera -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_pill" />

        <!-- Encabezado: ícono + título + curso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgSheetIcono"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_acceso_circle"
                android:importantForAccessibility="no"
                android:padding="13dp"
                app:tint="@color/brand_uv_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSheetTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSheetSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Estado -->
        <TextView
            android:id="@+id/txtSheetEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Puntaje destacado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSheetPuntaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_subtle"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star"
                    app:tint="@color/badge_warning_text" />

                <TextView
                    android:id="@+id/txtSheetPuntajeEtiqueta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtSheetPuntaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Filas de datos (ícono · etiqueta · valor) -->
        <LinearLayout
            android:id="@+id/layoutSheetFilas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Descripción (foros) -->
        <TextView
            android:id="@+id/txtSheetDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_body"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Nota -->
        <LinearLayout
            android:id="@+id/layoutSheetNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_stat_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_open_in_new"
                app:tint="@color/badge_info_text" />

            <TextView
                android:id="@+id/txtSheetNota"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text_body"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Acciones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetEminus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Abrir en Eminus"
            app:backgroundTint="@color/brand_uv_green"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_open_in_new" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetCerrar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
