<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil → Buzón de sugerencias (se envía a un Google Form) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSugerencias"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_subtle"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/abc_ic_ab_back_material"
            app:title="Buzón de sugerencias"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Encabezado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_acceso_circle"
                    android:importantForAccessibility="no"
                    android:padding="13dp"
                    android:src="@drawable/ic_edit_note"
                    app:tint="@color/brand_uv_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.15"
                    android:text="¿Una idea para mejorar la app o algo que no funciona? Cuéntanos: lo leemos todo."
                    android:textColor="@color/text_body"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tipo -->
            <TextView
                style="@style/TituloSeccionAjustes"
                android:text="¿QUÉ NOS QUIERES CONTAR?" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSugerencia"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="💡 Sugerencia" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFalla"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐞 Algo falla" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOtro"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 Otro" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Mensaje -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMensajeSug"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Escribe aquí tu sugerencia"
                app:counterEnabled="true"
                app:counterMaxLength="2000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editMensajeSug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:minLines="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contacto opcional -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Contacto (opcional)"
                app:helperText="Solo si quieres que te respondamos. Si lo dejas vacío, es anónimo."
                app:startIconDrawable="@drawable/ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editContactoSug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLength="120"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Datos técnicos -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chkDatosTecnicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="Incluir datos técnicos (versión de la app, modelo de teléfono y versión de Android)"
                android:textColor="@color/text_body"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDatosTecnicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/barraEnviarSug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarSug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar"
            app:backgroundTint="@color/brand_uv_green"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_send" />
    </FrameLayout>
</LinearLayout>
