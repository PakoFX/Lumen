<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_card">

    <!-- Barra de progreso delgada, verde igual al botón de Eminus -->
    <ProgressBar
        android:id="@+id/loginProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="#2E7D32"
        android:progressBackgroundTint="@color/border_subtle"
        app:layout_constraintTop_toTopOf="parent" />

    <WebView
        android:id="@+id/loginWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideOverlay"
        app:layout_constraintTop_toBottomOf="@id/loginProgressBar"
        app:layout_constraintBottom_toTopOf="@id/txtAvisoNoOficial" />

    <!-- Aviso legal fijo bajo el login de Eminus -->
    <TextView
        android:id="@+id/txtAvisoNoOficial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/aviso_no_oficial_corto"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Cubre el WebView mientras se sincroniza la credencial con MiUV en segundo plano -->
    <LinearLayout
        android:id="@+id/layoutSyncMiuv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="@color/brand_uv_green" />

        <TextView
            android:id="@+id/txtSyncMiuv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Preparando tu cuenta…"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Aviso destacado: por qué tarda -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/badge_closed_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/badge_warning_text"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_schedule"
                    app:tint="@color/badge_warning_text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.15"
                    android:text="Esto puede tardar hasta un minuto.
Estamos trayendo de MiUV tu credencial oficial y tu horario de clases. Solo pasa al iniciar sesión: al renovar tu sesión ya no se repite."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pasos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/pasoSync0"
                style="@style/Lumen.PasoSync"
                android:text="Entrando a MiUV" />

            <TextView
                android:id="@+id/pasoSync1"
                style="@style/Lumen.PasoSync"
                android:text="Programa educativo y datos oficiales" />

            <TextView
                android:id="@+id/pasoSync2"
                style="@style/Lumen.PasoSync"
                android:text="Foto y código QR de tu credencial" />

            <TextView
                android:id="@+id/pasoSync3"
                style="@style/Lumen.PasoSync"
                android:text="Horario de clases" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Tu contraseña no se guarda."
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
