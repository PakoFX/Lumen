<?xml version="1.0" encoding="utf-8"?>
<!-- Privacidad: nada de la app (sesión, credencial, foto, horario) sale del celular,
     ni al respaldo en la nube ni al pasar datos a un teléfono nuevo (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
