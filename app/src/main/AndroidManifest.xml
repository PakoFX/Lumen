<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISOS DE INTERNET Y RED -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- PERMISOS PARA DESCARGAS Y ACTUALIZACIONES -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Recordatorios locales: alarmas a la hora exacta y reprogramarlas al reiniciar -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".EminusApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eminus4"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- PUNTO DE ENTRADA REAL: Splash router (verifica sesión y redirige) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Eminus4">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla principal con Bottom Navigation (Cursos, Avisos, Perfil) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Pantalla de detalle de curso con actividades -->
        <activity
            android:name=".ui.courses.CourseDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Pantalla de detalle de actividad, instrucciones y entrega -->
        <activity
            android:name=".ui.courses.ActivityDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.courses.CourseDetailActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Visor de documentos en línea (PDF, Imágenes, Office) -->
        <activity
            android:name=".ui.viewer.FileViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Videos/audios de Eminus (gira con el celular sin reiniciar la reproducción) -->
        <activity
            android:name=".ui.viewer.ReproductorActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <!-- Módulos de Avisos y Notificaciones -->
        <activity
            android:name=".ui.messages.MessagesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.messages.MessageDetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.courses.AllActivitiesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.exams.ExamsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.forums.ForumsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Redactar / responder mensajes -->
        <activity
            android:name=".ui.messages.ComposeMessageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Foro: leer, comentar, responder y dar me gusta -->
        <activity
            android:name=".ui.horario.HorarioActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.notifications.PendientesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.courses.ElementoActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.forums.ForumDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Credencial Digital UV a Pantalla Completa (Offline y Brillo Máximo) -->
        <activity
            android:name=".ui.profile.CredentialFullscreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Pantalla de Login auxiliar en WebView -->
        <activity
            android:name=".ui.auth.LoginWebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Proveedor de archivos para abrir documentos y APKs de forma segura -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Perfil → Buzón de sugerencias (Google Form) -->
        <activity
            android:name=".ui.profile.SugerenciasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Perfil → Notificaciones -->
        <activity
            android:name=".notificaciones.NotificacionesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Recordatorios: suena la alarma → notificación -->
        <receiver
            android:name=".notificaciones.RecordatorioReceiver"
            android:exported="false" />

        <!-- Reprogramar recordatorios al reiniciar / actualizar la app / cambiar permiso de alarmas -->
        <receiver
            android:name=".notificaciones.ArranqueReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
